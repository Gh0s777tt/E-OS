From 9b8d4785e6a3fb0fb19c83d3cde16def805b217d Mon Sep 17 00:00:00 2001
From: eos <eos@local>
Date: Sun, 7 Jun 2026 02:36:03 +0200
Subject: [PATCH] E-OS: red/black bootloader theme + E-OS banner

---
 src/main.rs        | 3 ++-
 src/os/uefi/mod.rs | 5 +++--
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/src/main.rs b/src/main.rs
index 542b059..9fef1ac 100644
--- a/src/main.rs
+++ b/src/main.rs
@@ -450,8 +450,9 @@ fn elf_entry(data: &[u8]) -> (u64, bool) {
 }
 
 fn main(os: &impl Os) -> (usize, u64, KernelArgs) {
+    os.set_text_highlight(false); // E-OS: switch to red-on-black theme before anything prints
     println!(
-        "Redox OS Bootloader {} on {}",
+        "E-OS Bootloader {} on {}",
         env!("CARGO_PKG_VERSION"),
         os.name()
     );
diff --git a/src/os/uefi/mod.rs b/src/os/uefi/mod.rs
index bbd034b..602d5bd 100644
--- a/src/os/uefi/mod.rs
+++ b/src/os/uefi/mod.rs
@@ -342,8 +342,9 @@ impl Os for OsEfi {
     }
 
     fn set_text_highlight(&self, highlight: bool) {
-        let attr = if highlight { 0x70 } else { 0x07 };
-        status_to_result((self.st.ConsoleOut.SetAttribute)(self.st.ConsoleOut, attr)).unwrap();
+        // E-OS theme: bright red (0x0C) on black; selection is black on red (0x40).
+        let attr = if highlight { 0x40 } else { 0x0C };
+        let _ = status_to_result((self.st.ConsoleOut.SetAttribute)(self.st.ConsoleOut, attr));
     }
 }
 
