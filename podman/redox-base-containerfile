# Configuration file to install the recipe dependencies inside the Podman container

# Base image pinned by DIGEST, not by tag, as of 2026-08-30.
#
# WHY A DIGEST AND NOT apt VERSIONS. hadolint reports DL3008 ("pin versions in apt get install")
# against the RUN line below, and following that literally would be worse here: Debian removes
# superseded package versions from the archive, so a containerfile pinning 78 exact apt versions
# stops building the first time any of them rotates -- turning a reproducibility measure into a
# scheduled outage. Pinning the base image by digest fixes the package set deterministically for
# that image without depending on the archive keeping old versions.
#
# The tag is kept alongside the digest for readability. The digest is what podman resolves.
# To move to a newer base: pull the tag, read the new digest, and update it here in its own commit
# so the change is visible in review rather than arriving silently on the next build.
FROM docker.io/library/debian:trixie@sha256:5268cb2ba09b06de9b5c14217d3d023db8a18567635306d05209ae63cb005051

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        appstream \
        appstream-compose \
        autoconf \
        autoconf2.69 \
        automake \
        autopoint \
        bison \
        bsdextrautils \
        build-essential \
        cmake \
        curl \
        dos2unix \
        doxygen \
        expect \
        file \
        flex \
        fuse3 \
        g++ \
        genisoimage \
        git \
        git-lfs \
        gobject-introspection \
        gtk-doc-tools \
        gtk-update-icon-cache \
        help2man \
        ipxe-qemu \
        intltool \
        libaudiofile-dev \
        libdbus-glib-1-dev-bin \
        libfuse3-dev \
        libgdk-pixbuf2.0-bin \
        libglib2.0-dev-bin \
        libhtml-parser-perl \
        librsvg2-common \
        libsdl1.2-dev \
        libsdl2-ttf-dev \
        lzip \
        libtool-bin \
        m4 \
        make \
        meson \
        nano \
        nasm \
        ninja-build \
        patch \
        patchelf \
        perl \
        pkg-config \
        po4a \
        protobuf-compiler \
        qemu-system-x86 \
        qemu-system-arm \
        qemu-efi-aarch64 \
        python3 \
        python3-dev \
        python3-libxml2 \
        python3-mako \
        python3-venv \
        python3-yaml \
        rsync \
        ruby \
        sbsigntool \
        scons \
        ssh \
        texinfo \
        unifdef \
        unzip \
        wget \
        xdg-utils \
        xfonts-utils \
        xserver-xorg-dev \
        xutils-dev \
        xxd \
        zip \
        zstd \
    && if [ "$(uname -m)" = "x86_64" ]; then \
         apt-get install -y --no-install-recommends \
            libc6-dev-i386 \
            syslinux-utils \
    ; fi
