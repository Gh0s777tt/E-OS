# Configuration file to build linux toolchain using lower glibc constraint

# Base image pinned by DIGEST, not by tag, as of 2026-08-30.
#
# WHY A DIGEST AND NOT apt VERSIONS. hadolint reports DL3008 ("pin versions in apt get install")
# against the RUN line below, and following that literally would be worse here: Debian removes
# superseded package versions from the archive, so a containerfile pinning 78 exact apt versions
# stops building the first time any of them rotates -- turning a reproducibility measure into a
# scheduled outage. Pinning the base image by digest fixes the package set deterministically for
# that image without depending on the archive keeping old versions.
#
# The tag is kept alongside the digest for readability. The digest is what podman resolves.
# To move to a newer base: pull the tag, read the new digest, and update it here in its own commit
# so the change is visible in review rather than arriving silently on the next build.
FROM docker.io/library/debian:oldstable-backports@sha256:3d595fdcddb9329d1e9387c9f5accb56f09cb9a9e57ea283f08651853df1ee63

RUN apt-get update \
    && apt-get install -y --no-install-recommends -t oldstable-backports \
        autoconf \
        autoconf2.69 \
        automake \
        autopoint \
        bison \
        build-essential \
        cmake \
        curl \
        dos2unix \
        doxygen \
        expect \
        file \
        flex \
        fuse3 \
        g++ \
        git \
        git-lfs \
        help2man \
        libfuse3-dev \
        lzip \
        m4 \
        make \
        meson \
        nano \
        nasm \
        ninja-build \
        patch \
        patchelf \
        perl \
        pkg-config \
        po4a \
        python3 \
        rsync \
        scons \
        texinfo \
        unifdef \
        unzip \
        wget \
        zip \
        zstd
