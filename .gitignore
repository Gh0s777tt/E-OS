# Release checksums + signature are build outputs regenerated per-release by
# scripts/make-release.sh and shipped as release ASSETS — never a committed
# trust anchor (a committed copy goes stale and references non-shipped images).
/release/SHA256SUMS
/release/*.minisig
.eos-kernel-src
.eos-drivers-src
.eos-base-src
.DS_Store
# macOS AppleDouble sidecars (._foo) — appear when the tree is copied through
# macOS Finder onto exFAT/SMB; pure metadata noise on every other OS.
._*

# ── repo-signing SECRET keys — never tracked, never staged ──────────────────────────
# There was no entry here at all, so `keys/eos-repo-sign.secret.toml` would have been
# untracked but NOT ignored: a plain `git add -A` would have staged the release signing key.
# Ignoring it does not make committing it impossible (`git add -f` still works, and check 10
# in ci-integrity.sh catches the material itself), but it removes the accident.
keys/*.secret.toml
keys/*secret*
keys/*.key
!keys/*.pub
!keys/*.pub.toml
# ...but never the macOS AppleDouble shadows. The two negations above re-admit anything
# matching keys/*.pub.toml, and `._eos-repo-sign.pub.toml` matches it -- so the `._*` rule
# further up was overridden and one such file got committed (U-196). A negation has to be
# narrowed again straight afterwards, or it lets junk back in through the door it opened.
keys/._*

# Secure Boot signing key placed for the bootloader recipe (V2-N03) — off-repo, never tracked
build/sb-signing/
build/boot-signing/
